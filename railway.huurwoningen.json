{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "Dockerfile.huurwoningen-experiment"
  },
  "deploy": {
    "startCommand": "node scripts/huurwoningen-patchright-session.cjs",
    "preDeployCommand": [],
    "healthcheckPath": "/health",
    "healthcheckTimeout": 180,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 3,
    "drainingSeconds": 60
  }
}
