generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum SourceStatus {
  DISABLED
  HEALTHY
  DEGRADED
  BLOCKED
}

enum RunStatus {
  RUNNING
  SUCCEEDED
  FAILED
  DEGRADED
}

enum DeliveryStatus {
  PENDING
  SENDING
  SENT
  DEAD_LETTER
  UNCERTAIN
}

model Source {
  id                String           @id @default(cuid())
  name              String
  baseUrl           String
  allowedDomains    String[]
  status            SourceStatus     @default(DISABLED)
  intervalSeconds   Int              @default(900)
  baselineAt        DateTime?
  lastAttemptAt     DateTime?
  lastSuccessAt     DateTime?
  nextCheckAt       DateTime?
  monitorLeaseUntil DateTime?
  monitorLeaseToken String?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  profile           SiteProfile?
  runs              MonitoringRun[]
  listings          HousingListing[]
  search            SearchConfiguration?
  collectionState   SourceCollectionState?
}

// Adapter-owned, versioned state. Updated atomically with listings and outbox.
model SourceCollectionState {
  sourceId  String @id
  source    Source @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  state     Json
  updatedAt DateTime @updatedAt
}

model SiteProfile {
  id                String   @id @default(cuid())
  sourceId          String   @unique
  source            Source   @relation(fields: [sourceId], references: [id])
  searchUrls        String[]
  filters           Json
  authStrategy      String   @default("none")
  // References only; never plaintext secrets or browser state.
  secretsRef        String?
  browserStateRef   String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model MonitoringRun {
  id                String    @id @default(cuid())
  sourceId          String
  source            Source    @relation(fields: [sourceId], references: [id])
  status            RunStatus @default(RUNNING)
  startedAt         DateTime  @default(now())
  finishedAt        DateTime?
  listingsFound     Int?
  errorCategory     String?
  usedLlm           Boolean   @default(false)
  searchRevision    Int?
  searchSnapshot    Json?
  collectionScope   String?

  @@index([sourceId, startedAt])
}

model HousingListing {
  id                 String               @id @default(cuid())
  sourceId           String
  source             Source               @relation(fields: [sourceId], references: [id])
  externalId         String
  canonicalUrl       String
  urlFingerprint     String
  title              String
  city               String
  address            String?
  rentPrice          Decimal?             @db.Decimal(10, 2)
  serviceCosts       Decimal?             @db.Decimal(10, 2)
  areaM2             Decimal?             @db.Decimal(8, 2)
  rooms              Decimal?             @db.Decimal(4, 1)
  imageUrl           String?
  publishedAt        DateTime?
  detectedAt         DateTime             @default(now())
  lastSeenAt         DateTime             @default(now())
  availabilityStatus String               @default("unknown")
  rawSourceRef       String?
  notifications      NotificationOutbox[]

  @@unique([sourceId, externalId])
  @@unique([sourceId, urlFingerprint])
}

model NotificationOutbox {
  id                String         @id @default(cuid())
  listingId         String?
  listing           HousingListing? @relation(fields: [listingId], references: [id])
  destinationRef    String
  idempotencyKey    String         @unique
  status            DeliveryStatus @default(PENDING)
  attempts          Int            @default(0)
  nextAttemptAt     DateTime       @default(now())
  lockedUntil       DateTime?
  lockToken         String?
  lastErrorCategory String?
  payload           String
  telegramMessageId String?
  createdAt         DateTime       @default(now())
  sentAt            DateTime?

  @@index([status, nextAttemptAt])
}

// One bot-wide gate: serialized delivery and durable group rate limit.
model DeliveryGate {
  id            String   @id
  nextAttemptAt DateTime @default(now())
}

// Cursor and command replies commit together; replicas serialize polling in PostgreSQL.
model TelegramUpdateCursor {
  id     String @id
  offset Int    @default(0)
}

// One owner for v1. Future subscriptions can reference searches without owning adapters.
model SearchConfiguration {
  sourceId        String @id
  source          Source @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  ownerKey        String @default("admin")
  enabled         Boolean @default(true)
  filters         Json
  revision        Int @default(1)
  appliedRevision Int @default(1)
  updatedAt       DateTime @updatedAt
  changes         SearchChange[]
}

model SearchChange {
  id        String @id @default(cuid())
  sourceId  String
  search    SearchConfiguration @relation(fields: [sourceId], references: [sourceId], onDelete: Cascade)
  revision  Int
  enabled   Boolean
  filters   Json
  actor     String
  createdAt DateTime @default(now())
  @@unique([sourceId, revision])
}

model AdminSession {
  tokenHash String @id
  csrf      String
  expiresAt DateTime
  @@index([expiresAt])
}
