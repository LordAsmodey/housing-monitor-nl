NODE_ENV=development
PORT=3000
POSTGRES_USER=housing
POSTGRES_PASSWORD=local-development-only
POSTGRES_DB=housing
DATABASE_URL=postgresql://housing:local-development-only@localhost:5432/housing?schema=public
REDIS_URL=redis://localhost:6379
MONITOR_INTERVAL_SECONDS=900
# User confirmed written Vesteda permission on 2026-10-12; false pauses this source.
VESTEDA_MONITORING_ENABLED=true
# Gruno: Groningen, apartments and independent studios up to advertised €1500.
GRUNO_MONITORING_ENABLED=true
# Lamberink: rental houses and apartments, all cities and prices.
LAMBERINK_MONITORING_ENABLED=true
VANDERMEULEN_MONITORING_ENABLED=true
MAXX_MONITORING_ENABLED=true
SOLIDE_MONITORING_ENABLED=true
TELEGRAM_DELIVERY_ENABLED=false
TELEGRAM_MAX_ATTEMPTS=5
# Token is needed for delivery; the existing group ID is required for monitoring.
TELEGRAM_BOT_USERNAME=Housing_Monitor_NL_bot
# TELEGRAM_BOT_TOKEN=
# Required for automatic Funda monitoring; set to your existing Telegram group ID.
# TELEGRAM_CHAT_ID=
# LLM credentials are not needed yet.
# Optional second source: configure both values to enable Huurwoningen.
# HUURWONINGEN_BROWSER_ORIGIN=
# HUURWONINGEN_BROWSER_TOKEN=
# Never commit tokens, cookies, browser profiles or real credentials.
# Optional Sentry error monitoring; auth tokens are not needed for ingestion.
# SENTRY_DSN=
# SENTRY_ENVIRONMENT=development
# SENTRY_RELEASE=
SENTRY_CRONS_ENABLED=false


# Admin UI disabled until both credentials are provided. Never expose these to Vite.
ADMIN_LOGIN=Admin
ADMIN_PASSWORD=

RENTSOLUTIONS_MONITORING_ENABLED=true

# Rentola: Groningen, independent housing up to EUR 1500
RENTOLA_MONITORING_ENABLED=true

# Pararius browser worker: configure both values to enable the source.
# PARARIUS_BROWSER_ORIGIN=
# PARARIUS_BROWSER_TOKEN=

# 123Wonen: Groningen, independent housing up to EUR 1500
WONEN123_MONITORING_ENABLED=true
