{
  "name": "housing-monitor-nl",
  "version": "0.1.0",
  "private": true,
  "description": "Self-healing rental housing monitor for the Netherlands",
  "engines": {
    "node": ">=22 <25"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "start:dev": "tsx watch src/main.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test test/*.test.ts test/*.test.mjs",
    "telegram:check": "node --env-file-if-exists=.env scripts/telegram-setup.mjs check",
    "telegram:chats": "node --env-file-if-exists=.env scripts/telegram-setup.mjs chats",
    "telegram:test": "node --env-file-if-exists=.env scripts/telegram-setup.mjs test",
    "db:validate": "prisma validate",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "test:integration": "node --import tsx --test --test-concurrency=1 test/integration/*.test.ts",
    "outbox:admin": "node --env-file-if-exists=.env scripts/outbox-admin.mjs",
    "outbox:smoke": "node --env-file-if-exists=.env scripts/outbox-smoke.mjs",
    "funda:check": "node --env-file-if-exists=.env scripts/funda-check.cjs",
    "test:funda": "node --test test/funda.test.mjs",
    "sentry:smoke": "node --env-file-if-exists=.env scripts/sentry-smoke.cjs",
    "admin:dev": "npm --prefix admin run dev",
    "admin:build": "npm --prefix admin run build",
    "build:all": "npm run build && npm run admin:build"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.0",
    "@nestjs/core": "^11.1.0",
    "@nestjs/platform-express": "^11.1.0",
    "@prisma/client": "^6.19.0",
    "@sentry/node": "^11.7.0",
    "prisma": "^6.19.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.20.0",
    "typescript": "~5.9.3"
  }
}
